# Proxmox API
pm_api_url          = "https://your-proxmox-host:8006/api2/json"
pm_api_token_id     = "terraform@pam!iac"
pm_api_token_secret = "REPLACE_ME"
pm_tls_insecure     = true

# Target
target_node = "node1"  # Proxmox node name
vm_name     = "my-vm"  # VM name in Proxmox
vm_hostname = null     # Optional: hostname (defaults to vm_name)

# VM platform
vm_os_family = "linux" # linux | windows

# Linux template (required when vm_os_family="linux")
template = "rocky9-cloudinit-template"

# Windows templates (required when vm_os_family="windows")
# windows_server_version = "2022" # 2019 | 2022
# windows_template_2019  = "win2019-template"
# windows_template_2022  = "win2022-template"

# QEMU machine type (override if your template uses q35/UEFI, etc.)
vm_machine = "pc"

# Resources
cpu_sockets           = 1
cpu_cores_per_socket  = 2
memory_mb             = 2048  # 2 GB
disk_gb               = 20
disk_storage          = "local-lvm"

# Network
network_model  = "virtio"
network_bridge = "vmbr0"
ip_config      = "ip=dhcp"  # Or use: "ip=192.168.1.100/24,gw=192.168.1.1"

# Cloud-Init
cloudinit_user        = "rocky"  # Default user created by cloud-init
ssh_public_key_path   = "~/.ssh/id_ed25519.pub"  # Leave empty to use cloudinit_ssh_keys
# cloudinit_ssh_keys  = ["ssh-ed25519 AAAA... user@host"]  # Alternative to ssh_public_key_path
cloudinit_packages    = ["curl", "htop", "git"]  # Packages to install

# Misc
qemu_agent = true
tags       = ""  # Optional: comma-separated tags

TF_VAR_pm_tls_insecure="false"                 # true только для отладки

# === Инфраструктура
TF_VAR_target_node="node1"
TF_VAR_template="rocky9-cloudinit-template"
TF_VAR_disk_storage="local-lvm"

# === VM / хостнейм
TF_VAR_vm_name="my-vm"
TF_VAR_vm_hostname=""                          # пусто => возьмёт vm_name

# === Ресурсы
TF_VAR_cpu_sockets="1"
TF_VAR_cpu_cores_per_socket="2"
TF_VAR_memory_mb="2048"
TF_VAR_disk_gb="20"
TF_VAR_qemu_agent="true"
TF_VAR_tags=""                                 # например "prod,web"

# === Сеть
TF_VAR_network_model="virtio"
TF_VAR_network_bridge="vmbr0"
TF_VAR_ip_config="ip=dhcp"                     # или "ip=192.168.1.100/24,gw=192.168.1.1"

# === Cloud-Init / SSH
TF_VAR_cloudinit_user="rocky"
TF_VAR_ssh_public_key_path="~/.ssh/id_ed25519.pub"
# Альтернатива: список ключей (JSON-строка)
# TF_VAR_cloudinit_ssh_keys='["ssh-ed25519 AAAA... user@host"]'
TF_VAR_cloudinit_packages='["curl","htop","git"]'

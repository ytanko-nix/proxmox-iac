# Terraform
.terraform/
*.tfstate
*.tfstate.*.backup
*.tfstate.backup
crash.log
.terraform.lock.hcl
.terragrunt-cache/

# Sensitive configuration files - NEVER COMMIT
terraform/terraform.tfvars
terraform/*.tfvars.secrets
terraform/*.tfvars.secret
terraform/*.secrets
terraform/*.secret
*.auto.tfvars

# Environment files - NEVER COMMIT
.env
.env.local
.env.*.local

# Secret files and keys
*.key
*.pem
secrets/
vault/

# IDE
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python
.venv/
venv/
__pycache__/
*.pyc

# Logs
*.log

# EXCEPTION: Allow terraform.tfvars.example (template)
!terraform/terraform.tfvars.example
